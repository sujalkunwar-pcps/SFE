{
  "name": "banana-brain",
  "version": "1.0.0",
  "description": "Banana Brain — Distributed Mathematical Reasoning Puzzle Challenge Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/test-runner.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "db:init": "node src/database/init.js",
    "db:mysql": "node scripts/setup-mysql.js"
  },
  "keywords": [
    "banana-api",
    "distributed-systems",
    "puzzle-game",
    "express",
    "vanilla-js"
  ],
  "author": "University of Bedfordshire Student",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
