# Server Configuration
PORT=3000
NODE_ENV=development

# Session & Security
SESSION_SECRET=replace_with_a_secure_random_string_in_production
SESSION_NAME=banana_brain_sid
COOKIE_SECURE=false

# External Banana API
BANANA_API_BASE_URL=https://marcconrad.com/uob/banana/api.php
BANANA_API_TIMEOUT_MS=8000

# Database Configuration
# Supported drivers: 'sqlite' or 'mysql'
DB_DRIVER=sqlite
DB_SQLITE_PATH=./data/banana_brain.db

# MySQL Settings (for XAMPP / phpMyAdmin)
DB_MYSQL_HOST=127.0.0.1
DB_MYSQL_PORT=3306
DB_MYSQL_USER=root
DB_MYSQL_PASSWORD=
DB_MYSQL_DATABASE=banana_brain
